}

enum TrainingLoadSource {
  HEART_RATE
  PERCEIVED_EFFORT
}

enum RecoveryLevel {
  INSUFFICIENT_DATA
  FRESH
  OPTIMAL
  ELEVATED
  HIGH_STRAIN
}

type RecoveryStatus {
  status: RecoveryLevel!
  acuteLoad: Float!
  chronicLoad: Float!
