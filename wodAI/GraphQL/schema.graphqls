  source: WorkoutSource!
  optional: Boolean!
  components: [Component!]!
  strengthWorkouts: [StrengthWorkout!]!
  hiitPieces: [WorkoutHiitPiece!]!
  blocks: [WorkoutBlock!]!
  createdAt: DateTime!
  updatedAt: DateTime!
}

interface WorkoutBlock {
