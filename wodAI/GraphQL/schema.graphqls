}

enum StatType {
  MUSCLE_LOAD
  STRENGTH_VOLUME
  INTENSITY_MINUTES
  TRAINING_LOAD
}

enum StatShape {
  CATEGORICAL
  SERIES
}

interface StatResult {
  type: StatType!
  shape: StatShape!
  unit: String!
  total: Float
}

type CategoricalStat implements StatResult {
  type: StatType!
  shape: StatShape!
  unit: String!
  total: Float
  categories: [CategoryPoint!]!
}

type SeriesStat implements StatResult {
  type: StatType!
  shape: StatShape!
  unit: String!
  total: Float
  series: [SeriesPoint!]!
}

type CategoryPoint {
  label: String!
  value: Float!
}

type SeriesPoint {
  x: String!
  y: Float!
}